# Copy to backend/.env and fill in. Never commit the real .env.

SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase pooler (Project Settings > Database > Connection pooling)
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# 5432 = session mode: at most 15 clients, shared by the whole team.
#        Use it for local development and for running migrations.
# 6543 = transaction mode: many short connections. Use it for the deployed
#        server. The settings switch off what transaction mode can't keep
#        (server-side cursors, persistent connections) automatically.
#        Run migrations with DB_PORT=5432 python manage.py migrate
DB_PORT=5432
CORS_ORIGIN=http://localhost:3000

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Supabase Storage for incident report photos.
# Leave these blank and photos are written to backend/media/ on this machine
# instead -- fine for working alone, but a photo saved there is invisible to
# anyone else's server, because the database only carries the path.
#
# Fill them in from Project Settings > Storage > S3 access keys. Those keys
# bypass row-level security, so they belong here and never in the frontend.
# The bucket must exist and should be PRIVATE: URLs are signed and expire
# after an hour, because an incident photo shows someone's house and street.
SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_BUCKET=incident-photos
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=

# Optional
# DB_CONN_MAX_AGE=60        seconds to keep a connection open (session mode, gunicorn only)
# DB_TRANSACTION_POOLER=true force transaction-mode settings on another port
# CACHE_DIR=/var/cache/geoalert  where sessions are cached (default backend/.cache)
# BEHIND_PROXY=true          set when a reverse proxy (nginx, Render, etc.) sits in front:
#                            sign-in throttling then counts the address the proxy reports
#                            instead of the proxy's own. Leave unset otherwise, or anyone
#                            could dodge the throttle by sending a fake X-Forwarded-For.
