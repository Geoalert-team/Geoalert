# GeoAlert's settings on the server. setup.sh copies this to backend/.env and
# fills in the domain, the secret key and the library paths. Replace every
# __FILL_IN__ with the value from a working backend/.env. Never commit the result.

SECRET_KEY=__SECRET_KEY__
DEBUG=False
ALLOWED_HOSTS=__DOMAIN__

# Nginx sits in front of Django
BEHIND_PROXY=True
CSRF_TRUSTED_ORIGINS=https://__DOMAIN__
CORS_ORIGIN=https://__DOMAIN__
FRONTEND_URL=https://__DOMAIN__

# Supabase database
DB_NAME=postgres
DB_USER=__FILL_IN__
DB_PASSWORD=__FILL_IN__
DB_HOST=__FILL_IN__
DB_PORT=5432

# Password-reset emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=__FILL_IN__
EMAIL_HOST_PASSWORD=__FILL_IN__
DEFAULT_FROM_EMAIL=__FILL_IN__

# Uploaded photos. Django doesn't serve uploads in production, so these are required.
SUPABASE_S3_ENDPOINT=__FILL_IN__
SUPABASE_S3_BUCKET=__FILL_IN__
SUPABASE_S3_REGION=__FILL_IN__
SUPABASE_S3_KEY=__FILL_IN__
SUPABASE_S3_SECRET=__FILL_IN__

# Map libraries installed by setup.sh
GDAL_LIBRARY_PATH=__LIBDIR__/libgdal.so
GEOS_LIBRARY_PATH=__LIBDIR__/libgeos_c.so
