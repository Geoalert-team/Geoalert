# GeoAlert's backend settings for Render. Copy this somewhere private, replace
# every __FILL_IN__, and paste it into Render with "Add from .env".
# Never commit the filled-in copy.

# A long random value: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=__FILL_IN__
DEBUG=False

# Render's address and Vercel's address
ALLOWED_HOSTS=geoalert-talisay-api.onrender.com,geoalert-talisay.vercel.app
CSRF_TRUSTED_ORIGINS=https://geoalert-talisay.vercel.app
CORS_ORIGIN=https://geoalert-talisay.vercel.app
FRONTEND_URL=https://geoalert-talisay.vercel.app

# Vercel and Render both sit in front of Django
BEHIND_PROXY=True
FORWARDED_FOR_TRUST_FIRST=True

# Supabase: the Session pooler values from the Connect button, not the direct connection
DB_NAME=postgres
DB_USER=__FILL_IN__
DB_PASSWORD=__FILL_IN__
DB_HOST=__FILL_IN__
DB_PORT=5432

# Password-reset emails, through Brevo. Render's free plan blocks Gmail's ports.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=2525
EMAIL_HOST_USER=__FILL_IN__
EMAIL_HOST_PASSWORD=__FILL_IN__
DEFAULT_FROM_EMAIL=__FILL_IN__

# Uploaded photos. Django doesn't serve uploads in production, so these are required.
SUPABASE_S3_ENDPOINT=__FILL_IN__
SUPABASE_S3_BUCKET=__FILL_IN__
SUPABASE_S3_REGION=__FILL_IN__
SUPABASE_S3_KEY=__FILL_IN__
SUPABASE_S3_SECRET=__FILL_IN__
