[Unit]
Description=GeoAlert web application
After=network-online.target
Wants=network-online.target

[Service]
User=geoalert
WorkingDirectory=/opt/geoalert/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/opt/geoalert/backend/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 120 --access-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
